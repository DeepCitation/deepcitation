
node_modules
**/__pycache__/
**/*.pyc
.env
# Ignore built ts files
lib/**/*
/dist/
# .test.js are compiled build artifacts of .test.ts/.test.tsx — exclude to prevent bun running each test twice
src/__tests__/**/*.test.js
src/parsing/__tests__/**/*.test.js
src/render/__tests__/**/*.test.js
examples/**/*.test.js
# Compiled .js doubles of .ts/.tsx sources under test/showcase dirs. With raw JSX they
# break the Vite/rollup CT build ("JSX syntax is disabled" — .js disables JSX parsing).
# The .ts/.tsx sources are authoritative; resolveJsToTs maps .js imports back to them.
src/__tests__/**/*.js
src/react/testing/*.js
tests/playwright/**/*.js
*.tsbuildinfo

bun.lock

.turbo/
.agents/
.claude/
skills-lock.json

/scratch/
/output/
/plans/
/playwright/.cache/
/test-results/
/playwright-report/
/blob-report/
/test-screenshots/
cleanup-failure-*.png
test-failure-*.png
*.test.png
*.spec.png
# Playwright snapshots: only AVIF versions are committed; PNGs are intermediates
**/__snapshots__/**/*.png

bundle-stats*

package-lock.json

examples/**/.env
examples/**/bun.lock
examples/**/package-lock.json
examples/**/local.tgz
examples/**/.next
examples/**/next-env.d.ts
examples/**/output/
examples/**/test-results/

firebase-debug.log

ag-ui-client*
.playwright-mcp/
.deepcitation/

# Auto-generated vanilla runtime
src/vanilla/_generated*.ts
