# Get your free API key at https://deepcitation.com/signup
DEEPCITATION_API_KEY=dc-your-deepcitation-key

# OpenAI API key used for embeddings and chat generation
OPENAI_API_KEY=sk-your-openai-key

# Optional: cached attachment IDs to skip re-uploading corpus PDFs on cold starts.
# On first run, the server uploads each PDF and logs the ID — paste it here.
# DEEPCITATION_ATTACHMENT_YC_SAFE=
# DEEPCITATION_ATTACHMENT_NVDA_FORM144=
# DEEPCITATION_ATTACHMENT_ATTENTION_IS_ALL_YOU_NEED=
# DEEPCITATION_ATTACHMENT_WHY_HALLUCINATE=

# Optional: rate limit thresholds (defaults shown). Set RATE_LIMIT_DISABLED=true to turn off entirely.
# RATE_LIMIT_MAX_PER_DAY=100
# RATE_LIMIT_MAX_PER_IP_PER_DAY=5
# RATE_LIMIT_DISABLED=false
