# Get your free API key at https://deepcitation.com/signup
DEEPCITATION_API_KEY=sk-dc-your_api_key_here

# OpenAI API key
OPENAI_API_KEY=sk-your-openai-key

# Cached attachment IDs for the bundled corpus (speeds up cold starts).
# After first run, check server logs for the IDs and paste them here.
DEEPCITATION_ATTACHMENT_YC_SAFE=
DEEPCITATION_ATTACHMENT_NVDA_FORM144=
DEEPCITATION_ATTACHMENT_ATTENTION_IS_ALL_YOU_NEED=
DEEPCITATION_ATTACHMENT_WHY_HALLUCINATE=

# Rate limiting (optional — defaults shown)
# RATE_LIMIT_MAX_PER_DAY=100
# RATE_LIMIT_MAX_PER_IP_PER_DAY=5
# RATE_LIMIT_DISABLED=true
